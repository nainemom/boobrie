{
	"name": "boobrie",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": "24.15"
	},
	"main": "./src/relay/main.ts",
	"scripts": {
		"lefthook:install": "lefthook install",
		"prepare": "run-s lefthook:install lint:fix",
		"lint": "biome check",
		"lint:staged": "biome check --staged --no-errors-on-unmatched",
		"lint:ci": "biome ci",
		"lint:fix": "biome check --write --unsafe",
		"bump": "./bump.sh",
		"generate:migrations": "drizzle-kit generate",
		"test": "echo \"All fake tests passed!\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
		"build:ts": "tsc -b",
		"build:vite": "vite build",
		"build:client": "run-s build:ts build:vite",
		"dev:client": "vite",
		"dev:relay": "tsx watch src/relay/main.ts",
		"start:relay": "tsx src/relay/main.ts"
	},
	"dependencies": {
		"@dicebear/core": "^9.4.3",
		"@dicebear/notionists": "^9.4.2",
		"@dicebear/styles": "^10.2.0",
		"@hookform/resolvers": "^5.4.0",
		"@noble/curves": "^2.2.0",
		"@scure/base": "^2.2.0",
		"@scure/bip39": "^2.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"dexie": "^4.4.4",
		"dexie-react-hooks": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"h3": "^2.0.1-rc.25",
		"ofetch": "^1.5.1",
		"pg": "^8.22.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.82.0",
		"serwist": "^9.5.11",
		"swr": "^2.4.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.3",
		"web-push": "^3.6.7",
		"wouter": "^3.10.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@serwist/vite": "^9.5.11",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/web-push": "^3.6.4",
		"@vitejs/plugin-react": "^6.0.3",
		"changelogen": "^0.6.2",
		"drizzle-kit": "^0.31.10",
		"lefthook": "^2.1.10",
		"npm-run-all2": "^9.0.2",
		"tsx": "^4.23.1",
		"typescript": "~6.0.2",
		"vite": "^8.1.1"
	},
	"allowScripts": {
		"lefthook@2.1.10": true,
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true
	}
}