{
	"name": "boobrie",
	"private": true,
	"version": "0.0.8",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"main": "./src/relay/main.ts",
	"scripts": {
		"lefthook:install": "lefthook install",
		"lint": "biome check",
		"lint:staged": "biome check --staged --no-errors-on-unmatched",
		"lint:ci": "biome ci",
		"lint:fix": "biome check --write --unsafe",
		"db:start": "docker compose -f compose.dev.yml up -d --wait postgres",
		"db:stop": "docker compose -f compose.dev.yml stop postgres",
		"db:generate-types": "prisma generate",
		"db:generate-migrations": "prisma migrate dev",
		"db:apply-migrations": "prisma migrate deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"build:client-ts": "tsc -b",
		"build:client-vite": "vite build",
		"build:client": "run-s build:client-ts build:client-vite",
		"dev:client": "vite",
		"dev:relay": "tsx watch src/relay/main.ts",
		"start:relay": "tsx src/relay/main.ts"
	},
	"dependencies": {
		"@dicebear/core": "^10.7.0",
		"@dicebear/styles": "^10.6.0",
		"@hookform/resolvers": "^5.4.0",
		"@noble/curves": "^2.2.0",
		"@noble/hashes": "^2.2.0",
		"@prisma/adapter-pg": "^7.9.0",
		"@prisma/client": "^7.9.0",
		"@scure/base": "^2.2.0",
		"@scure/bip39": "^2.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"dexie": "^4.4.4",
		"dexie-react-hooks": "^4.4.0",
		"dotenv": "^17.4.2",
		"h3": "^2.0.1-rc.31",
		"lucide-react": "^1.26.0",
		"ofetch": "^1.5.1",
		"pg": "^8.22.0",
		"prisma": "^7.9.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.82.0",
		"serwist": "^9.5.11",
		"swr": "^2.4.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.3",
		"web-push": "^3.6.7",
		"wouter": "^3.10.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@anolilab/unplugin-favicons": "^4.0.1",
		"@biomejs/biome": "^2.5.4",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@serwist/vite": "^9.5.11",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/web-push": "^3.6.4",
		"@vitejs/plugin-react": "^6.0.3",
		"changelogen": "^0.6.2",
		"fake-indexeddb": "^6.2.5",
		"favicons": "^7.3.1",
		"happy-dom": "^20.11.6",
		"lefthook": "^2.1.10",
		"node-fetch-native": "^1.6.7",
		"npm-run-all2": "^9.0.2",
		"tsx": "^4.23.1",
		"typescript": "~6.0.2",
		"vite": "^8.1.1",
		"vite-plugin-open-graph": "^2.2.0",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"lefthook@2.1.10": true,
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"prisma@7.9.0": true,
		"@prisma/engines@7.9.0": true
	}
}