generator client {
	provider = "prisma-client"
	output   = "./generated"
}

datasource db {
	provider = "postgresql"
}

model PendingMessage {
	id        String   @id @default(uuid())
	sender    String
	recipient String
	payload   String
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

	@@index([recipient, id])
	@@map("pending_messages")
}

model User {
	address      String   @id
	role         String   @default("user")
	handle       String?  @unique
	discoverable Boolean  @default(true)
	/// The one device this account is signed in on; any other is turned away and
	/// signs itself out. Set by logging in, which is how an account moves. Null
	/// only for an account predating this column, and claimed on its next verify.
	activeDeviceId String? @map("active_device_id")
	createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

	@@map("users")
}

model PushSubscription {
	address      String   @id
	subscription String
	createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

	@@map("push_subscriptions")
}

model Session {
	id        String   @id @default(uuid())
	address   String
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

	@@index([address])
	@@map("sessions")
}
